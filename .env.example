# Wzór pliku .env — skopiuj jako .env i uzupełnij. Plik .env nie trafia do gita.

# Główny model (DeepSeek V4.1 Flash, model ID: deepseek-flash)
DEEPSEEK_API_KEY=

# Opcjonalnie: modele zapasowe (można podmienić w konfiguracji bez zmian w kodzie)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Bot Telegram (późniejszy etap)
TELEGRAM_BOT_TOKEN=
